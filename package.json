{
  "name": "nexora-one-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Nexora One Engine — sovereign full-stack platform with the Nora Itu autonomous runtime (zero third-party LLM APIs).",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "build:public": "cross-env VITE_APP_MODE=public tsc --noEmit && vite build --outDir dist-public",
    "build:admin": "cross-env VITE_APP_MODE=admin tsc --noEmit && vite build --outDir dist-admin",
    "package:offline": "npm run build && node scripts/package-offline.js",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "preview": "npm run build && npm run start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "lucide-react": "^0.540.0",
    "motion": "^12.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.0",
    "three": "^0.187.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
