# ─────────────────────────────────────────────────────────────
#  Nexora One Engine — configuración de entorno
#  Copia este archivo a `.env` y ajusta los valores.
#  No existe ninguna dependencia de APIs LLM de terceros.
# ─────────────────────────────────────────────────────────────

# HTTP gateway
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false
RATE_LIMIT_PER_MIN=30

# ── Nora Itu Core: daemon de inferencia local / self-hosted ──
NORA_ITU_ENDPOINT=http://127.0.0.1:8080
NORA_ITU_PROTOCOL=openai
NORA_ITU_MODEL=nora-itu
NORA_ITU_AUTH_TOKEN=
NORA_ITU_URL=http://127.0.0.1:8000/v1/chat/completions

# Generación
NORA_ITU_TEMPERATURE=0.6
NORA_ITU_MAX_TOKENS=1024

# Tolerancia a fallos
NORA_ITU_CONNECT_TIMEOUT_MS=15000
NORA_ITU_TIMEOUT_MS=120000
NORA_ITU_MAX_RETRIES=2
NORA_ITU_CB_THRESHOLD=3
NORA_ITU_CB_COOLDOWN_MS=30000
NORA_ITU_FALLBACK=true

# ── Supabase (Sync del catálogo de productos y compras) ──
VITE_SUPABASE_URL=tu_supabase_url
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key
